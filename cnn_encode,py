'''
This is another autencoder, mirroring our LSTM design but with a CNN this time.

'''

class Encoder(nn.Module):
    def __init__(self, in_ch, base_ch, num_layers, dropout):
        super().__init__()
        blocks = []
        c_in = in_ch
        c = base_ch
        for _ in range(num_layers):
            blocks += [
                nn.Conv1d(c_in, c, kernel_size=5, stride=2, padding=2),
                nn.BatchNorm1d(c),
                nn.ReLU(inplace=True),
                nn.Dropout(dropout),
            ]
            c_in = c
            c = min(c * 2, 512)  # optional cap on width growth
        self.conv = nn.Sequential(*blocks)
        self.feat_ch = c_in
        self.gap = nn.AdaptiveAvgPool1d(1)   # -> [B, feat_ch, 1]
        self.to_latent = nn.Linear(self.feat_ch, latent_dim)

    def forward(self, x_btc):               # x_btc: [B,T,C]
        x = x_btc.permute(0,2,1)            # -> [B,C,T]
        f = self.conv(x)                    # [B, feat_ch, T']
        pooled = self.gap(f).squeeze(-1)    # [B, feat_ch]
        z = self.to_latent(pooled)          # [B, latent_dim]
        return z, f
    

class Decoder(nn.Module):
    def __init__(self, feat_ch, out_ch, num_layers, dropout, seq_len):
        super().__init__()
        self.seq_len = seq_len
        self.num_layers = num_layers

        # length after encoder
        self.seed_len = max(1, math.ceil(seq_len / (2 ** num_layers)))
        self.from_latent = nn.Linear(latent_dim, feat_ch * self.seed_len)

        ups = []
        c_in = feat_ch
        c = max(feat_ch // 2, out_ch)
        for _ in range(num_layers):
            ups += [
                nn.Upsample(scale_factor=2, mode='nearest'),
                nn.Conv1d(c_in, max(c, out_ch), kernel_size=3, padding=1),
                nn.BatchNorm1d(max(c, out_ch)),
                nn.ReLU(inplace=True),
                nn.Dropout(dropout),
            ]
            c_in = max(c, out_ch)
            c = max(c // 2, out_ch)
        self.up = nn.Sequential(*ups)
        self.head = nn.Conv1d(c_in, out_ch, kernel_size=3, padding=1)

    def forward(self, z):                     # z: [B, latent_dim]
        B = z.size(0)
        seed = self.from_latent(z).view(B, -1, self.seed_len)  # [B, feat_ch, seed_len]
        x = self.up(seed)                     # [B, ~feat_ch, ~T]
        x = self.head(x)                      # [B, C, L~]
        L = x.shape[-1]
        if L > self.seq_len: x = x[..., :self.seq_len]
        elif L < self.seq_len: x = nn.functional.pad(x, (0, self.seq_len - L))
        return x.permute(0,2,1)              # -> [B,T,C]


class CNNAutoencoder(nn.Module):
    def __init__(self, input_size, base_ch, num_layers, dropout, seq_len):
        super().__init__()
        self.encoder = Encoder(input_size, base_ch, num_layers, dropout)
        self.decoder = Decoder(self.encoder.feat_ch, input_size, num_layers, dropout, seq_len)

    def forward(self, x_btc):
        z, _ = self.encoder(x_btc)
        recon = self.decoder(z)
        return recon, z
    

